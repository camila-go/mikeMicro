# Server-side only. Never prefix this with VITE_, which would inline it into
# the browser bundle and publish the key to anyone who loads the page.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase. The publishable key is designed to be public: it only permits
# what row level security allows. Never put the service role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
